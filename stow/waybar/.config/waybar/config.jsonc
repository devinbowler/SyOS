// SyOS - the cockpit.
//
// Every control here is reachable with the mouse alone; nothing on this bar
// requires or hints at a keyboard shortcut. Reading left to right: open
// something, arrange the frame, close what is in front, then the tools and
// the state of the machine.
//
// All text is lower case. Capitals are for the things you opened, which show
// up in sway's tab strip; the chrome around them stays quiet.
//
// There is no workspace module. SyOS has one workspace - see the sway config
// for why - and the tab strip is the only list of "things you can switch to".
//
// Custom modules shell out to the scripts in stow/syos/.local/bin. They all
// route through syos-summon, so a button focuses what is already open instead
// of stacking duplicates.
{
  "layer": "top",
  "position": "top",
  // 0 = size from CSS min-height, which theme.css derives from the palette.
  "height": 0,
  "spacing": 0,

  "modules-left": [
    "custom/launcher",
    "custom/tabs",
    "custom/cols",
    "custom/rows",
    "custom/close"
  ],
  "modules-center": [],
  "modules-right": [
    "custom/terminal",
    "custom/browser",
    "custom/calendar",
    "network",
    "pulseaudio",
    "battery",
    "custom/clock"
  ],

  // --- Open ---------------------------------------------------------------

  "custom/launcher": {
    "format": "+",
    "tooltip": true,
    "tooltip-format": "open an application",
    "on-click": "syos-menu"
  },

  // --- Arrange the frame --------------------------------------------------
  // Tabs are the default. These are the deliberate way out of it, and back.

  "custom/tabs": {
    "format": "tabs",
    "tooltip": true,
    "tooltip-format": "one window at a time, the rest as tabs",
    "on-click": "syos-layout tabs"
  },

  "custom/cols": {
    "format": "cols",
    "tooltip": true,
    "tooltip-format": "all windows side by side",
    "on-click": "syos-layout cols"
  },

  "custom/rows": {
    "format": "rows",
    "tooltip": true,
    "tooltip-format": "all windows stacked top to bottom",
    "on-click": "syos-layout rows"
  },

  "custom/close": {
    "format": "\u00d7",
    "tooltip": true,
    "tooltip-format": "close the window in front (or middle-click any tab)",
    "on-click": "swaymsg kill"
  },

  // --- Tools --------------------------------------------------------------

  "custom/terminal": {
    "format": "term",
    "tooltip": true,
    "tooltip-format": "terminal",
    "on-click": "syos-summon -a foot -- foot"
  },

  "custom/browser": {
    "format": "web",
    "tooltip": true,
    "tooltip-format": "chrome",
    // -x keeps this button off the calendar, which is also a Chrome window.
    "on-click": "syos-summon -a Google-chrome -x '^Google Calendar' -- google-chrome"
  },

  "custom/calendar": {
    "format": "cal",
    "tooltip": true,
    "tooltip-format": "calendar",
    "on-click": "syos-calendar"
  },

  // --- Status -------------------------------------------------------------

  "network": {
    "format-wifi": "wifi {essid} {signalStrength}%",
    "format-ethernet": "eth",
    "format-linked": "eth (no ip)",
    "format-disconnected": "offline",
    "tooltip-format": "{ifname} {ipaddr}/{cidr}",
    "on-click": "foot -a syos-nmtui nmtui"
  },

  "pulseaudio": {
    "format": "vol {volume}%",
    "format-muted": "vol muted",
    "on-click": "pavucontrol",
    "scroll-step": 5
  },

  "battery": {
    // Absent on desktops and in VMs; waybar skips modules that fail to
    // initialise, so this stays in the config for the laptop fleet.
    "states": { "warning": 25, "critical": 10 },
    "format": "bat {capacity}%",
    "format-charging": "chg {capacity}%",
    "format-plugged": "ac {capacity}%",
    "tooltip-format": "{timeTo}"
  },

  // A custom module rather than waybar's clock purely to get lower case:
  // strftime yields "Tue", and waybar's format strings cannot change case.
  "custom/clock": {
    "exec": "date '+%a %d %b  %H:%M' | tr '[:upper:]' '[:lower:]'",
    "interval": 30,
    "tooltip": true,
    "tooltip-format": "open the calendar",
    "on-click": "syos-calendar"
  }
}
