// SyOS - the cockpit.
//
// Every control here is reachable with the mouse alone; nothing on this bar
// requires or hints at a keyboard shortcut. Reading left to right: open
// something, move between workspaces, shape and close the current window,
// jump to a tool, check the machine.
//
// Custom modules shell out to the scripts in stow/syos/.local/bin. They all
// route through syos-summon, so a button focuses what is already open instead
// of stacking duplicates.
{
  "layer": "top",
  "position": "top",
  // 0 = size from CSS min-height, which theme.css derives from the palette.
  "height": 0,
  "spacing": 0,

  "modules-left": [
    "custom/launcher",
    "sway/workspaces",
    "custom/splith",
    "custom/splitv",
    "custom/close"
  ],
  "modules-center": ["sway/window"],
  "modules-right": [
    "custom/terminal",
    "custom/browser",
    "custom/calendar",
    "network",
    "pulseaudio",
    "battery",
    "clock"
  ],

  // --- Open ---------------------------------------------------------------

  "custom/launcher": {
    "format": "+",
    "tooltip": true,
    "tooltip-format": "Open an application",
    "on-click": "syos-menu"
  },

  "sway/workspaces": {
    // Mouse-first: click a workspace to switch, scroll over the module to
    // cycle. Neither may depend on a keybind.
    "disable-scroll": false,
    "disable-click": false,
    "all-outputs": true,
    "format": "{name}",
    // Sway destroys a workspace the moment it empties. Listing them here
    // keeps all five buttons on the bar at all times, so the set of rooms is
    // something you can see and click rather than something you memorise.
    "persistent-workspaces": {
      "0:Board": [],
      "1:Work": [],
      "2:Web": [],
      "3:Comms": [],
      "4:Ops": []
    }
  },

  // --- Shape the current window -------------------------------------------
  // Tabs are the default, so these two are the deliberate escape into a
  // split: press one, then open the next thing from "+".

  "custom/splith": {
    "format": "|",
    "tooltip": true,
    "tooltip-format": "Next window opens beside this one",
    "on-click": "swaymsg splith"
  },

  "custom/splitv": {
    "format": "\u2014",
    "tooltip": true,
    "tooltip-format": "Next window opens below this one",
    "on-click": "swaymsg splitv"
  },

  "custom/close": {
    "format": "\u00d7",
    "tooltip": true,
    "tooltip-format": "Close the focused window",
    "on-click": "swaymsg kill"
  },

  "sway/window": {
    "max-length": 80,
    "tooltip": false
  },

  // --- Tools --------------------------------------------------------------

  "custom/terminal": {
    "format": "term",
    "tooltip": true,
    "tooltip-format": "Terminal",
    "on-click": "syos-summon foot foot"
  },

  "custom/browser": {
    "format": "web",
    "tooltip": true,
    "tooltip-format": "Chrome",
    "on-click": "syos-summon Google-chrome google-chrome"
  },

  "custom/calendar": {
    "format": "cal",
    "tooltip": true,
    "tooltip-format": "Calendar",
    "on-click": "syos-calendar"
  },

  // --- Status -------------------------------------------------------------

  "network": {
    "format-wifi": "wifi {essid} {signalStrength}%",
    "format-ethernet": "eth",
    "format-linked": "eth (no ip)",
    "format-disconnected": "offline",
    "tooltip-format": "{ifname} {ipaddr}/{cidr}",
    "on-click": "foot -a syos-nmtui nmtui"
  },

  "pulseaudio": {
    "format": "vol {volume}%",
    "format-muted": "vol muted",
    "on-click": "pavucontrol",
    "scroll-step": 5
  },

  "battery": {
    // Absent on desktops and in VMs; waybar skips modules that fail to
    // initialise, so this stays in the config for the laptop fleet.
    "states": { "warning": 25, "critical": 10 },
    "format": "bat {capacity}%",
    "format-charging": "chg {capacity}%",
    "format-plugged": "ac {capacity}%",
    "tooltip-format": "{timeTo}"
  },

  "clock": {
    "interval": 30,
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    // The clock is where you look when you want to know about time, so it is
    // also the largest target for opening the full calendar.
    "on-click": "syos-calendar"
  }
}
