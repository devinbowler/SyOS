#!/usr/bin/env bash
# syos-summon - focus an application if it is already open, otherwise start it.
#
# Usage: syos-summon <match> <command> [args...]
#
# <match> is compared case-insensitively against each window's Wayland app_id,
# falling back to its XWayland class. This is what makes the bar's tool buttons
# idempotent: clicking "cal" five times gives you one calendar, focused, rather
# than five copies of it. Every button on the cockpit goes through here.

set -euo pipefail

if [ $# -lt 2 ]; then
	echo "usage: syos-summon <app_id|class> <command> [args...]" >&2
	exit 2
fi

match=$1
shift

# recurse() walks tiled and floating windows alike; leaf windows are the only
# ones carrying app_id or window_properties.class, so containers fall out.
if swaymsg -t get_tree 2>/dev/null | jq -e --arg m "$match" '
	[ recurse(.nodes[]?, .floating_nodes[]?)
	  | select(((.app_id // .window_properties.class // "") | ascii_downcase)
	           == ($m | ascii_downcase)) ] | length > 0
' >/dev/null 2>&1; then
	# Already open. Try both criteria; the one that does not match is a no-op.
	swaymsg "[app_id=\"(?i)^${match}\$\"] focus" >/dev/null 2>&1 || true
	swaymsg "[class=\"(?i)^${match}\$\"] focus" >/dev/null 2>&1 || true
	exit 0
fi

exec "$@"
